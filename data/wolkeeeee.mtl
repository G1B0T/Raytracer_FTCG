newmtl wolke
Ns 250.000000
Ka 1.000000 1.000000 1.000000  # Ambient Color (weiß)
Kd 1.000000 1.000000 1.000000  # Diffuse Color (weiß)
Ks 0.000000 0.000000 0.000000  # Specular Color (kein Glanz)
Ke 0.000000 0.000000 0.000000  # Emissive (nicht leuchtend)
Ni 1.500000
d 1.000000                     # Deckkraft (1 = voll sichtbar)
illum 2                        # Beleuchtungsmodell mit Spekular
